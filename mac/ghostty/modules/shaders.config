# ╭─────────────────────────────────────────────────────╮
# │             Shader Visual Effects                   │
# ╰─────────────────────────────────────────────────────╯
#
# Multiple shaders can be enabled at the same time.
# They are applied in order, where the output of one
# becomes the input of the next.


# ─── Animated: Cursor / Interaction Effects ───────────
# (Subtle effects, recommended for everyday use)

# Cursor smear (Ghostty paints the trail; Neovim smear-cursor is off)
custom-shader = ~/.config/ghostty/shaders/cursor-smear.glsl

# Softer smear fade (alternative — don't run both)
# custom-shader = ~/.config/ghostty/shaders/cursor-smear-fade.glsl

# Cursor trail
# custom-shader = ~/.config/ghostty/shaders/cursor_blaze.glsl

# Spotlight follows the cursor
# custom-shader = ~/.config/ghostty/shaders/auto-tracking-spotlight.glsl

# Slowly drifting spotlight
# custom-shader = ~/.config/ghostty/shaders/spotlight.glsl

# CRT-style glowing cursor trail
# (Designed to be used with in-game-crt.glsl)
# custom-shader = ~/.config/ghostty/shaders/in-game-crt-cursor.glsl

# Gaming CRT effect
# (Scanlines, curved screen, vignette)
# custom-shader = ~/.config/ghostty/shaders/in-game-crt.glsl


# ─── Static Effects ───────────────────────────────────
# (Look good even with animation disabled.
# Lowest CPU usage.)

# Bloom
# Creates a soft glow around bright colors.
 custom-shader = ~/.config/ghostty/shaders/bloom.glsl

# Improved CRT
# Curved screen + scanlines
# custom-shader = ~/.config/ghostty/shaders/bettercrt.glsl

# Classic CRT
# Scanlines + pixel grid + chromatic aberration
# custom-shader = ~/.config/ghostty/shaders/crt.glsl

# Bayer dithering
# Pixel-art / dot-matrix style rendering
# custom-shader = ~/.config/ghostty/shaders/dither.glsl

# Negative colors
# Inverts every color on the screen
# custom-shader = ~/.config/ghostty/shaders/negative.glsl

# Retro green-screen terminal
# custom-shader = ~/.config/ghostty/shaders/retro-terminal.glsl


# modified retro terminal
custom-shader = ~/.config/ghostty/shaders/modified-retro.glsl

# TFT LCD pixel grid overlay
# custom-shader = ~/.config/ghostty/shaders/tft.glsl


# ─── Animated: Background Scenes / Particles ──────────
# (Visually impressive, but can be distracting.)

# Green Matrix code rain
# custom-shader = ~/.config/ghostty/shaders/matrix-hallway.glsl

# Matrix-style mystical symbol rain
# custom-shader = ~/.config/ghostty/shaders/inside-the-matrix.glsl

# Rotating 3D cubes
# custom-shader = ~/.config/ghostty/shaders/cubes.glsl

# Mechanical gears and conveyor belts
# custom-shader = ~/.config/ghostty/shaders/gears-and-belts.glsl

# Water surface with ripples and reflections
# custom-shader = ~/.config/ghostty/shaders/water.glsl

# Underwater distortion and refraction
# custom-shader = ~/.config/ghostty/shaders/underwater.glsl

# Animated sine-wave interference pattern
# custom-shader = ~/.config/ghostty/shaders/sin-interference.glsl


# ─── Animated: Screen Filters / Post Processing ───────

# RGB split + bloom + color channel jitter
# Cyberpunk / glitch effect
# custom-shader = ~/.config/ghostty/shaders/glow-rgbsplit-twitchy.glsl

# Periodic digital glitch effect
# custom-shader = ~/.config/ghostty/shaders/glitchy.glsl

# Drunken camera effect
# Screen wobbles and distorts
# custom-shader = ~/.config/ghostty/shaders/drunkard.glsl

# Simplex noise
# Mostly used as a dependency for other shaders
# custom-shader = ~/.config/ghostty/shaders/mnoise.glsl


# Shader animation mode
#
# true
#   Animate while Ghostty is focused.
#
# false
#   Render only when terminal contents change.
#   (Animations appear frozen.)
#
# always
#   Keep animating continuously,
#   even when Ghostty is not focused.
custom-shader-animation = true
