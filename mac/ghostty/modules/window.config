# ╭─────────────────────────────────────────────────────╮
# │          Window / Shell / Mouse Settings            │
# ╰─────────────────────────────────────────────────────╯

# macOS title bar style:
#   transparent
#   hidden
#   tabs
#   native
macos-titlebar-style = hidden

# Window padding
window-padding-x = 0
window-padding-y = 0

# Window decorations
# auto | none | etc.
window-decoration = auto

# Automatically copy selected text to the clipboard
copy-on-select = clipboard

# Initial window size (columns × rows)
window-width = 160
window-height = 45

# Startup command
# Launches a custom shell script that can detect
# macOS / Linux / WSL and start the appropriate environment.
command = shell:~/.config/ghostty/scripts/launch.sh

# Right-click action
right-click-action = paste

# Mouse Shift Capture
#
# Normally:
#   Shift + Click is intercepted by Ghostty to extend text selection.
#
# Setting this to "always" sends the Shift key directly
# to applications like Neovim.
#
# Even if the application requests Shift events via XTSHIFTESCAPE,
# Ghostty continues forwarding them.
mouse-shift-capture = always

# Mouse scroll sensitivity
#
# Keep scrolling at the standard speed.
#
# Ghostty defaults to:
#   discrete:3
#
# which makes Neovim scroll several lines per wheel tick.
#
# This setting restores normal one-step scrolling.
mouse-scroll-multiplier = discrete:1

# Shell Integration
#
# Allows Ghostty to detect:
#   • Command start
#   • Command completion
#   • Prompt position
#
# Some notifications and terminal features rely on this.
shell-integration = detect

# Enable shell integration features:
#
# cursor  → Track cursor position
# sudo    → Detect sudo commands
# title   → Update terminal title automatically
shell-integration-features = cursor,sudo,title

# Close windows immediately without confirmation.
confirm-close-surface = true

# macOS:
# Treat the Option key as Alt (Meta),
# useful for terminal shortcuts and Neovim.
macos-option-as-alt = true

# Quit Ghostty automatically when the last window closes.
quit-after-last-window-closed = true
