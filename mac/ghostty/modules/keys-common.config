# ╭─────────────────────────────────────────────────────╮
# │      Common Keybindings (Shared Across All Modes)   │
# ╰─────────────────────────────────────────────────────╯
#
# Tab management and pane splitting are configured separately in:
#   - standalone-keymap.config (Ghostty manages tabs/splits)
#   - tmux-keymap.config       (tmux manages windows/panes)
#
# These are mutually exclusive.
# Use ONE or the other:
#   Ghostty manages tabs  ↔  tmux manages windows


# ------------------------------------------------------
# Remove ALL Ghostty default keybindings
# ------------------------------------------------------
#
# Prevent Ghostty defaults (Cmd+D, Cmd+F, etc.)
# from conflicting with tmux or Neovim.
#
keybind = clear


# ------------------------------------------------------
# Re-add essential system shortcuts
# ------------------------------------------------------

# Copy
keybind = cmd+c=copy_to_clipboard:mixed

# Paste
keybind = cmd+v=paste_from_clipboard


# ------------------------------------------------------
# Disable default Cmd+T / Cmd+W
# ------------------------------------------------------
#
# Prevent macOS menu shortcuts from stealing these keys.
#
keybind = cmd+t=unbind
keybind = cmd+w=unbind


# ------------------------------------------------------
# Font Zoom
# ------------------------------------------------------

keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size


# ------------------------------------------------------
# Send keys that terminals normally can't generate.
# Inject CSI-u sequences directly.
# (Bypasses tmux key re-encoding.)
# ------------------------------------------------------

#
# Which application receives the key depends on the setup.
#
# Example:
#   Ctrl+`
#       intercepted by tmux
#
#   Ctrl+Shift+L
#       reaches Neovim
#

# Ctrl+`
# Opens tmux popup terminal.
keybind = ctrl+grave_accent=text:\x1b[96;5u

# Ctrl+Shift+L
# Used by vim-visual-multi "Select All".
keybind = ctrl+shift+l=text:\x1b[108;6u


# ------------------------------------------------------
# Miscellaneous
# ------------------------------------------------------

# New Ghostty window
keybind = ctrl+shift+n=new_window

# Paste
keybind = ctrl+shift+v=paste_from_clipboard
